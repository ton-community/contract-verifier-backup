      "filename": "tmp/af3be295-c561-45f7-9457-850878689572/contracts/src/types.tolk",
      "contents": "enum Errors {\n    InvalidOption  = 100\n    AlreadyVoted   = 101\n    NotFromPoll    = 102\n    NotOwner       = 103\n    PollClosed     = 104\n    InvalidMessage = 0xFFFF\n}\n\n// ----- Poll storage -----\n\nstruct PollStorage {\n    owner:    address\n    option0:  uint32\n    option1:  uint32\n    isClosed: bool\n}\n\nfun PollStorage.load(): PollStorage {\n    return PollStorage.fromCell(contract.getData());\n}\n\nfun PollStorage.save(self) {\n    contract.setData(self.toCell());\n}\n\n// ----- Voter storage -----\n\nstruct VoterStorage {\n    poll: address\n    voter: address\n    hasVoted: bool\n}\n\nfun VoterStorage.load(): VoterStorage {\n    return VoterStorage.fromCell(contract.getData());\n}\n\nfun VoterStorage.save(self) {\n}\n\n// ----- Messages -----\n\nstruct (0x694d6f6e) Vote {\n    option: uint8\n}\n\nstruct (0x14160e21) ClosePoll {}\n"
