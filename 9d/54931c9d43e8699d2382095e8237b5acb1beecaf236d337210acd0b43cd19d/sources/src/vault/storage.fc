#include "../../../node_modules/@layerzerolabs/layerzero-v2-ton/src/funC++/classlib.fc";
#include "../../../node_modules/@layerzerolabs/layerzero-v2-ton/src/funC++/actions/utils.fc";
#include "../../../node_modules/@layerzerolabs/layerzero-v2-ton/src/protocol/core/baseStorage.fc";

#include "./interface.fc";

;; required object name
const int Vault::NAME = "Vault"u;

;; field names
const int Vault::baseStorage = 0; ;; == BASE_STORAGE_INDEX

const int Vault::assetWalletAddress = 1;
const int Vault::shareMinterAddress = 2;
const int Vault::mintNanos = 3;
;; the TON address of the person who deposits money into the vault
const int Vault::rewarderAddress = 4;   
const int Vault::assetBalance = 5;
const int Vault::totalShares = 6;
const int Vault::tentativeOwner = 7;
const int Vault::cooldownDuration = 8;
const int Vault::lastDistributionTimestamp = 9;
const int Vault::vestingAmount = 10;
const int Vault::vestingDuration = 11;

;; @owner app owner EOA/Multisig
cell Vault::New(int owner) method_id {
    return cl::declare(
        Vault::NAME,
        unsafeTuple([
            [cl::t::objRef, BaseStorage::New(owner)], ;; Vault::baseStorage
            [cl::t::address, NULLADDRESS],            ;; Vault::assetWalletAddress
            [cl::t::address, NULLADDRESS],            ;; Vault::shareMinterAddress
            [cl::t::coins, 0],                        ;; Vault::mintNanos
            [cl::t::address, NULLADDRESS],            ;; Vault::rewarderAddress
            [cl::t::uint256, 0],                      ;; Vault::assetBalance
            [cl::t::uint256, 0],                      ;; Vault::totalShares
            [cl::t::address, NULLADDRESS],            ;; Vault::tentativeOwner
            [cl::t::uint64, 0],                       ;; Vault::cooldownDuration
            [cl::t::uint64, 0],                       ;; Vault::lastDistributionTimestamp
            [cl::t::coins, 0],                        ;; Vault::vestingAmount
            [cl::t::uint64, 0]                        ;; Vault::vestingDuration
        ])
    );
}


;;; =============================== GETTERS =========================================

cell Vault::getBaseStorage(cell $storage) impure inline method_id {
    return $storage.cl::get<objRef>(Vault::baseStorage);
}

int Vault::getRewarderAddress(cell $storage) impure inline method_id {
    return $storage.cl::get<address>(Vault::rewarderAddress);
}

int Vault::getAssetWalletAddress(cell $storage) impure inline method_id {
    return $storage.cl::get<address>(Vault::assetWalletAddress);
}

int Vault::getShareMinterAddress(cell $storage) impure inline method_id {
    return $storage.cl::get<address>(Vault::shareMinterAddress);
}

int Vault::getMintNanos(cell $storage) impure inline method_id {
    return $storage.cl::get<coins>(Vault::mintNanos);
}

int Vault::getAssetBalance(cell $storage) impure inline method_id {
    return $storage.cl::get<uint256>(Vault::assetBalance);
}

int Vault::getTotalShares(cell $storage) impure inline method_id {
    return $storage.cl::get<uint256>(Vault::totalShares);
}

(int, int) Vault::getAssetBalanceAndTotalShares(cell $storage) impure inline method_id {
    return (
        $storage.cl::get<uint256>(Vault::assetBalance), 
        $storage.cl::get<uint256>(Vault::totalShares)
    );
}

int Vault::getTentativeOwner(cell $storage) impure inline method_id {
    return $storage.cl::get<address>(Vault::tentativeOwner);
}

int Vault::getCooldownDuration(cell $storage) impure inline method_id {
    return $storage.cl::get<uint64>(Vault::cooldownDuration);
}

int Vault::getLastDistributionTimestamp(cell $storage) impure inline method_id {
    return $storage.cl::get<uint64>(Vault::lastDistributionTimestamp);
}

int Vault::getVestingAmount(cell $storage) impure inline method_id {
    return $storage.cl::get<coins>(Vault::vestingAmount);
}

int Vault::getVestingDuration(cell $storage) impure inline method_id {
    return $storage.cl::get<uint64>(Vault::vestingDuration);
}
