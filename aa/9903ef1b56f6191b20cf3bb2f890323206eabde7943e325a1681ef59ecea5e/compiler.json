      "filename": "tmp/52ead654-9940-4381-a649-daa21f418cb8/contracts/Master.tolk",
      "contents": "import \"types\"\n\ncontract Master {\n    author: \"Acton User\"\n    version: \"1.0.0\"\n    description: \"Minimal starter contract with owner management\"\n    storage: Storage\n    incomingMessages: AllowedMessage\n}\n\ntype AllowedMessage = ChangeOwner | DeployChild | TestBounce\ntype TheoreticallyBounceable = MyMessage\n\nfun calcDeployedChild(parent: address, childContractCode: cell): AutoDeployAddress {\n    return AutoDeployAddress {\n        stateInit: ContractState {\n            code: childContractCode,\n            data: ChildStorage {\n                parent,\n                seqno: 0,\n            }.toCell(),\n        },\n    };\n}\n\nfun onInternalMessage(in: InMessage) {\n    if (in.body.isEmpty()) {\n        return;\n    }\n    val msg = AllowedMessage.fromSlice(in.body);\n\n    match (msg) {\n        ChangeOwner => {\n            var storage = lazy Storage.load();\n            assert (in.senderAddress == storage.owner) throw Errors.NotOwner;\n            storage.owner = msg.newOwner;\n            storage.save();\n        }\n        DeployChild => {\n            val storage = lazy Storage.load();\n            assert (in.senderAddress == storage.owner) throw Errors.NotOwner;\n            val deployMsg = createMessage({\n                bounce: BounceMode.NoBounce,\n                value: ton(\"0.02\"),\n                dest: calcDeployedChild(contract.getAddress(), storage.childContractCode),\n            });\n            deployMsg.send(SEND_MODE_PAY_FEES_SEPARATELY);\n        }\n        TestBounce => {\n            val storage = lazy Storage.load();\n            assert (in.senderAddress == storage.owner) throw Errors.NotOwner;\n            if (msg.sendWithoutStateInit) {\n                val msgToChild = createMessage({\n                    bounce: BounceMode.RichBounce,\n                    value: ton(\"0\"),\n                    dest: calcDeployedChild(\n                        contract.getAddress(),\n                        storage.childContractCode,\n                    ).calculateAddress(),\n                    body: MyMessage {\n                        seqno: 1 as uint256,\n                        salt: 2 as uint256,\n                        traceId: 3 as uint256,\n                        extraData: beginCell().storeUint(0xABCDEF, 24).endCell(),\n                        produceError: msg.produceError,\n                    },\n                });\n                msgToChild.send(SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE | SEND_MODE_BOUNCE_ON_ACTION_FAIL);\n            } else {\n                val msgToChild = createMessage({\n                    bounce: BounceMode.RichBounce,\n                    value: ton(\"0\"),\n                    dest: calcDeployedChild(contract.getAddress(), storage.childContractCode),\n                    body: MyMessage {\n                        seqno: 1 as uint256,\n                        salt: 2 as uint256,\n                        traceId: 3 as uint256,\n                        extraData: beginCell().storeUint(0xABCDEF, 24).endCell(),\n                        produceError: msg.produceError,\n                    },\n                });\n                msgToChild.send(SEND_MODE_CARRY_ALL_REMAINING_MESSAGE_VALUE | SEND_MODE_BOUNCE_ON_ACTION_FAIL);\n            }\n        }\n    }\n}\n\nfun onBouncedMessage(in: InMessageBounced) {\n    var storage = lazy Storage.load();\n    val rich = lazy RichBounceBody.fromSlice(in.bouncedBody);\n    val msg = lazy TheoreticallyBounceable.fromSlice(rich.originalBody.beginParse());\n    match (msg) {\n        MyMessage => {\n            storage.lastBouncedBody = msg.toCell();\n        }\n    }\n    storage.save();\n}\n\nget fun owner(): address {\n    val storage = lazy Storage.load();\n    return storage.owner;\n}\n\nget fun id(): uint64 {\n    val storage = lazy Storage.load();\n    return storage.id;\n}\n\nget fun lastBouncedBody(): cell {\n    val storage = lazy Storage.load();\n    return storage.lastBouncedBody;\n}\n\nget fun childContractAddress(): address {\n    val storage = lazy Storage.load();\n    return calcDeployedChild(contract.getAddress(), storage.childContractCode).calculateAddress();\n}\n"
    },
    {
      "filename": "tmp/52ead654-9940-4381-a649-daa21f418cb8/contracts/types.tolk",
      "contents": "enum Errors {\n    NotOwner = 100\n    InvalidMessage = 0xFFFF\n}\n\nconst PRODUCE_ERROR: uint8 = 1\nconst NOT_PRODUCE_ERROR: uint8 = 0\n\nstruct Storage {\n    owner: address\n    id: uint64\n    lastBouncedBody: cell\n    childContractCode: cell\n}\n\nfun Storage.load(): Storage {\n    return Storage.fromCell(contract.getData());\n}\n\nfun Storage.save(self) {\n    contract.setData(self.toCell());\n}\n\nstruct (0x2ce05111) ChangeOwner {\n    newOwner: address\n}\n\nstruct (0x4d794d73) MyMessage {\n    seqno: uint256\n    salt: uint256\n    traceId: uint256\n    extraData: cell\n    produceError: bool\n}\n\nstruct (0x6465706c) DeployChild {}\n\nstruct (0x74627374) TestBounce {\n    produceError: bool\n    sendWithoutStateInit: bool\n}\n\nstruct ChildStorage {\n    parent: address\n    seqno: uint256\n}\n"
    }
  ]
