      "filename": "tmp/96c8ac6d-2904-4177-b31a-73b8fd2cf1e5/contracts/src/Singer.tolk",
      "contents": "import \"types\"\n\ncontract Singer {\n    author: \"Acton User\"\n    version: \"1.0.0\"\n    description: \"Minimal singer contract with owner-controlled updates\"\n    storage: Storage\n    incomingMessages: AllowedMessage\n}\n\ntype AllowedMessage =\n    | IncreaseSinger\n    | DecreaseSinger\n    | ResetSinger\n\nfun onInternalMessage(in: InMessage) {\n    val msg = lazy AllowedMessage.fromSlice(in.body);\n\n    match (msg) {\n        IncreaseSinger => {\n            var storage = lazy Storage.load();\n            assert (storage.owner == in.senderAddress) throw Errors.NotOwner;\n\n            storage.singer += msg.increaseBy;\n            storage.save();\n        }\n        DecreaseSinger => {\n            var storage = lazy Storage.load();\n            assert (storage.owner == in.senderAddress) throw Errors.NotOwner;\n            assert (storage.singer >= msg.decreaseBy) throw Errors.SingerUnderflow;\n\n            storage.singer -= msg.decreaseBy;\n            storage.save();\n        }\n        ResetSinger => {\n            var storage = lazy Storage.load();\n            assert (storage.owner == in.senderAddress) throw Errors.NotOwner;\n\n            storage.singer = 0;\n            storage.save();\n        }\n        else => {\n            assert (in.body.isEmpty()) throw Errors.InvalidMessage;\n        }\n    }\n}\n\nfun onBouncedMessage(_in: InMessageBounced) {}\n\nget fun currentSinger(): int {\n    val storage = lazy Storage.load();\n\n    return storage.singer;\n}\n\nget fun owner(): address {\n    val storage = lazy Storage.load();\n\n    return storage.owner;\n}\n"
    },
    {
      "filename": "tmp/96c8ac6d-2904-4177-b31a-73b8fd2cf1e5/contracts/src/types.tolk",
      "contents": "enum Errors {\n    NotOwner = 100\n    SingerUnderflow = 0x1001\n    InvalidMessage = 0xFFFF\n}\n\nstruct Storage {\n    id: uint32\n    owner: address\n    singer: uint32\n}\n\nfun Storage.load(): Storage {\n    return Storage.fromCell(contract.getData());\n}\n\nfun Storage.save(self) {\n    contract.setData(self.toCell());\n}\n\nstruct (0x7e8764ef) IncreaseSinger {\n    increaseBy: uint32\n}\n\nstruct (0x283b4c3f) DecreaseSinger {\n    decreaseBy: uint32\n}\n\nstruct (0x3a752f06) ResetSinger {}\n"
    }
  ]
